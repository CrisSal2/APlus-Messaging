# Copy to .env and fill in
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random chars (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
# Monday.com app signing secret. Must differ from JWT_SECRET.
MONDAY_SIGNING_SECRET=

# Comma-separated allowed browser origins (required when NODE_ENV=production)
CORS_ORIGINS=http://localhost:8301
# Set to 1 when behind a reverse proxy (so rate limiting sees client IPs)
# TRUST_PROXY=1
# Return invite tokens in the API response (default: true except in production)
# INVITE_RETURN_TOKEN=true
PORT=4000
